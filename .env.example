# Copie para .env e ajuste se necessário.
# docker compose up -d lê estas variáveis na raiz do workspace.

POSTGRES_USER=licitall
POSTGRES_PASSWORD=licitall
POSTGRES_DB=licitall

# Portas no host (ajuste se 5432/6379/8080 já estiverem em uso)
LICITALL_POSTGRES_PORT=5433
LICITALL_REDIS_PORT=6380
LICITALL_EVOLUTION_PORT=8081
LICITALL_EVOLUTION_UI_PORT=3001

# API FastAPI (host)
LICITALL_HOST=0.0.0.0
LICITALL_PORT=8000
DATABASE_URL=postgresql+asyncpg://licitall:licitall@localhost:5433/licitall
REDIS_URL=redis://localhost:6380/0

# Armazenamento de PDFs (Edital / TR)
RAW_DOCS_DIR=data/raw

# PNCP
PNCP_CONSULTA_BASE_URL=https://pncp.gov.br/api/consulta
PNCP_CORE_BASE_URL=https://pncp.gov.br/api/pncp
PNCP_TIMEOUT_SECONDS=60
PNCP_PAGE_SIZE=50

# Minha Receita (serviço local no Compose)
MINHA_RECEITA_BASE_URL=http://localhost:8001

# Evolution API (WhatsApp)
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=licitall-dev-evolution-key
EVOLUTION_INSTANCE=licitall

# LLM (fases 2+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
