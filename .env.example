# Copie para .env e ajuste se necessário.
# docker compose up -d lê estas variáveis na raiz do workspace.

POSTGRES_USER=licitall
POSTGRES_PASSWORD=licitall
POSTGRES_DB=licitall

# Portas no host (ajuste se 5432/6379/8080 já estiverem em uso)
LICITALL_POSTGRES_PORT=5433
LICITALL_REDIS_PORT=6380
LICITALL_EVOLUTION_PORT=8081
LICITALL_EVOLUTION_UI_PORT=3001

# API FastAPI (host)
LICITALL_HOST=0.0.0.0
LICITALL_PORT=8000
DATABASE_URL=postgresql+asyncpg://licitall:licitall@localhost:5433/licitall
REDIS_URL=redis://localhost:6380/0

# Armazenamento de PDFs (Edital / TR)
RAW_DOCS_DIR=data/raw

# PNCP
PNCP_CONSULTA_BASE_URL=https://pncp.gov.br/api/consulta
PNCP_CORE_BASE_URL=https://pncp.gov.br/api/pncp
PNCP_TIMEOUT_SECONDS=60
PNCP_PAGE_SIZE=50

# Minha Receita (serviço local no Compose)
MINHA_RECEITA_BASE_URL=http://localhost:8001

# Evolution API (WhatsApp)
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=licitall-dev-evolution-key
EVOLUTION_INSTANCE=licitall

# LLM (fases 2+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# auto: OpenAI se houver chave, senão Gemini, senão hash local. Valores: auto | openai | gemini | hash
EMBEDDING_PROVIDER=auto
# Endpoint compatível com OpenAI (Ollama, FreeLLMAPI...); usa OPENAI_API_KEY como chave
EMBEDDING_BASE_URL=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Autenticação
# E-mails (separados por vírgula) que viram operadores da plataforma: captação PNCP, pipeline, envios globais.
ADMIN_EMAILS=
# true: qualquer pessoa pode criar conta em /ui/cadastro.html. false: só via `python -m scripts.criar_usuario`.
AUTH_REGISTRATION_OPEN=true
SESSION_TTL_HOURS=12
# true quando a aplicação estiver atrás de HTTPS (o cookie de sessão passa a exigir conexão segura).
COOKIE_SECURE=false
# true libera /docs e /openapi.json (lista todas as rotas): só em desenvolvimento.
DEBUG=false

# Busca reversa e aviso diário
REVERSE_MATCH_ENABLED=true
REVERSE_MATCH_MAX_TENDERS=200
DIGEST_SCHEDULER_ENABLED=true
DIGEST_SCHEDULER_INTERVAL_SECONDS=60
DIGEST_RETRY_MINUTES=15

# ---------------- Produção (docker compose --profile app up -d --build) ----------------
# Veja docs/usuario/OPERACAO_DOCKER.md. Com APP_ENV=production a API RECUSA subir se alguma destas estiver fraca/padrão.
APP_ENV=development
# Domínio público com DNS apontado para o servidor (HTTPS automático). localhost = certificado local só para teste.
DOMAIN=localhost
# Gere valores aleatórios longos, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=licitall
POSTGRES_PASSWORD=
POSTGRES_DB=licitall
EVOLUTION_API_KEY=
# Portas do proxy (padrão 80/443)
HTTP_PORT=80
HTTPS_PORT=443
# true inclui o Docling (OCR): imagem de vários GB
INSTALL_DOCLING=false
# Minha Receita usada pela API no container. Vazio = serviço local (perfil "full", exige ETL de dezenas de GB).
# Sem a base local: MINHA_RECEITA_PROD_URL=https://minhareceita.org
MINHA_RECEITA_PROD_URL=
